<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_18"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/bg_result_measurement"
        android:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_18"
            android:layout_marginVertical="@dimen/dp_12"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/emoji_status"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_face_nutral"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vital_name"
                style="@style/TextViewStyleBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/text_color"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                tools:text="Heart Rate"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/emoji_status"/>


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vital_icon"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_8"
                android:src="@drawable/ic_vital_scanning_heart_rate"
                app:layout_constraintBottom_toBottomOf="@+id/vital_value"
                app:layout_constraintStart_toEndOf="@+id/vital_unit"
                app:layout_constraintTop_toTopOf="@+id/vital_value" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vital_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_color"
                android:textSize="@dimen/sp_20"
                android:layout_marginTop="@dimen/dp_18"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/emoji_status"
                app:layout_constraintTop_toBottomOf="@+id/vital_name"
                tools:text="78" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vital_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:textColor="@color/text_color"
                android:textSize="@dimen/sp_12"
                tools:text="bpm"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintBottom_toBottomOf="@id/vital_value"
                app:layout_constraintStart_toEndOf="@id/vital_value" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vital_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color"
                android:textSize="@dimen/sp_12"
                tools:text="True"
                android:fontFamily="@font/inter_reguler"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vital_value" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/view_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:fontFamily="@font/inter_reguler"
                android:textColor="@color/theme_color"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vital_status"
                />

<!--            <androidx.appcompat.widget.AppCompatTextView-->
<!--                android:id="@+id/vital_confidence"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="@dimen/dp_6"-->
<!--                android:textColor="@color/text_color"-->
<!--                android:fontFamily="@font/inter_reguler"-->
<!--                android:textSize="@dimen/sp_12"-->
<!--                tools:text="Confidence Level is High"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintTop_toBottomOf="@id/vital_status" />-->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vital_status">

                <androidx.cardview.widget.CardView
                    android:id="@+id/confidence_indicator"
                    android:layout_width="@dimen/dp_22"
                    android:layout_height="@dimen/dp_22"
                    android:layout_marginVertical="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_12"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/inside_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp_3"
                        app:cardCornerRadius="@dimen/dp_12"
                        app:cardElevation="@dimen/dp_0"
                        tools:cardBackgroundColor="@color/good_dot_color" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/vital_confidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:fontFamily="@font/inter_medium"
                    android:text="High Confidence"
                    android:textColor="@color/secondary_theme_text_color"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/confidence_indicator"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/desc_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_more">

                <View
                    android:id="@+id/ref_view"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_2"
                    android:background="@color/default_btn_bg_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/vital_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="@dimen/dp_12"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp_14"
                    app:fontFamily="@font/inter_reguler"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ref_view" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/vital_desclaimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="@dimen/dp_18"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:text="@string/disclaimer_desc"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/sp_10"
                    app:fontFamily="@font/inter_reguler"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vital_description" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <ImageButton
                android:id="@+id/expandButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Expand or Collapse"
                android:src="@drawable/ic_collapse"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>
