<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_background_color">

        <include
            android:id="@+id/tool"
            layout="@layout/toolbar_layout_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/scrl_vw"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:fillViewport="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tool">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tool">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dp_18"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ic_illstration"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:src="@drawable/ic_illustration_login"
                        app:layout_constraintBottom_toTopOf="@+id/layout_sign_up"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_sign_up" />

                    <TextView
                        android:id="@+id/tv_header_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:enabled="false"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="Hi, Welcome to VitalSelf\nSign Up"
                        android:textColor="@color/secondary_front_color"
                        android:textSize="@dimen/sp_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_username"
                        style="@style/style_edit_text"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_20"
                        android:drawableStart="@drawable/ic_person"
                        android:fontFamily="@font/inter_reguler"
                        android:hint="User Name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_header_text" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_email"
                        style="@style/style_edit_text"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_20"
                        android:drawableStart="@drawable/ic_person"
                        android:fontFamily="@font/inter_reguler"
                        android:hint="Email Address"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/et_username" />


                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_pasword"
                        style="@style/style_edit_text"
                        android:layout_marginTop="@dimen/dp_18"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:drawableStart="@drawable/ic_password"
                        android:fontFamily="@font/inter_reguler"
                        android:hint="Password"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_email" />


                    <TextView
                        android:id="@+id/tv_cred_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:enabled="false"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:text="incorrect or empty please check username or password"
                        android:textColor="@color/error_msg_text_color"
                        android:textSize="@dimen/sp_14"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_pasword" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_sign_up"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginHorizontal="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_18"
                        android:background="@drawable/bg_primary_button"
                        android:elevation="8dp"
                        android:shadowColor="@color/primary_shadow_color"
                        android:textColor="@color/primary_button_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_cred_error">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_bold"
                            android:gravity="center"
                            android:text="Sign Up"
                            android:textColor="@color/secondary_front_color"
                            android:textSize="@dimen/sp_18" />
                    </androidx.cardview.widget.CardView>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_sign_up"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <TextView
                            android:id="@+id/tv_sign_up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/inter_reguler"
                            android:layout_marginEnd="@dimen/dp_6"
                            android:text="Privacy Policy"
                            android:textColor="@color/theme_btn_clicked_color"
                            android:textSize="@dimen/sp_12"
                            app:layout_constraintEnd_toStartOf="@+id/ref_view"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/ref_view"
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp_0"
                            android:background="@color/default_btn_bg_color"
                            app:layout_constraintBottom_toBottomOf="@id/tv_sign_up"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tv_sign_up" />

                        <TextView
                            android:id="@+id/tv_listener_sign_up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:layout_marginStart="@dimen/dp_6"
                            android:fontFamily="@font/inter_reguler"
                            android:text="Terms &amp; Conditions"
                            android:textColor="@color/theme_btn_clicked_color"
                            android:textSize="@dimen/sp_12"
                            app:layout_constraintStart_toEndOf="@id/ref_view"
                            app:layout_constraintTop_toTopOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>






    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
