<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_background_color">

        <include
            android:id="@+id/tool"
            layout="@layout/toolbar_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:orientation="vertical"
            android:layout_margin="@dimen/dp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tool">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_first_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tv_tell_us"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:enabled="false"
                    android:gravity="center"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:text="Tell us about yourself!"
                    android:textSize="@dimen/sp_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_18"
                    android:enabled="false"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:text="Full name"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_tell_us" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_first_name"
                    style="@style/style_edit_text"
                    android:hint="Enter your full name"
                    android:fontFamily="@font/inter_reguler"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:drawableStart="@drawable/ic_person"
                    app:layout_constraintTop_toBottomOf="@+id/tv_first_name"
                     />

                <TextView
                    android:id="@+id/tv_first_name_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Please enter your name"
                    android:textColor="@color/error_msg_text_color"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_first_name" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_age_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_age_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Age"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="@dimen/dp_4"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_age_name"
                    style="@style/style_edit_text"
                    android:hint="Enter your age"
                    android:inputType="number"
                    android:maxLength="3"
                    android:fontFamily="@font/inter_reguler"
                    android:imeOptions="actionNext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:drawableStart="@drawable/ic_calendar_month"
                    app:layout_constraintTop_toBottomOf="@+id/tv_age_name"
                    />

                <TextView
                    android:id="@+id/tv_age_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:enabled="false"
                    android:text="Yrs"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintBottom_toBottomOf="@+id/et_age_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/et_age_name" />

                <TextView
                    android:id="@+id/tv_age_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Please enter your age"
                    android:visibility="gone"
                    android:textColor="@color/error_msg_text_color"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_age_name" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:enabled="false"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:text="Height"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_height"
                    style="@style/style_edit_text"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/dp_18"
                    android:drawableStart="@drawable/ic_height"
                    android:fontFamily="@font/inter_reguler"
                    android:hint="Enter your height"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    app:layout_constraintEnd_toStartOf="@+id/til_height_unit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_height" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_height_unit"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="@dimen/dp_125"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_height">

                    <AutoCompleteTextView
                        android:id="@+id/et_height_unit"
                        style="@style/style_edit_text"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:editable="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter_reguler"
                        android:paddingBottom="@dimen/dp_15" />

                </com.google.android.material.textfield.TextInputLayout>



                <TextView
                    android:id="@+id/tv_height_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Please enter your height"
                    android:visibility="gone"
                    android:textColor="@color/error_msg_text_color"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_height" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Weight"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_weight"
                    style="@style/style_edit_text"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/dp_18"
                    android:drawableStart="@drawable/ic_weight"
                    android:fontFamily="@font/inter_reguler"
                    android:hint="Enter your weight"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    app:layout_constraintEnd_toStartOf="@+id/til_weight_unit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_weight" />


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_weight_unit"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="@dimen/dp_125"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_weight">

                    <AutoCompleteTextView
                        android:id="@+id/et_weight_unit"
                        style="@style/style_edit_text"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:editable="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter_reguler"
                        android:paddingBottom="@dimen/dp_15" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_weight_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Please enter your weight"
                    android:visibility="gone"
                    android:textColor="@color/error_msg_text_color"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_weight" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Sex"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_gender"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_55"
                    app:boxCornerRadiusBottomEnd="@dimen/dp_18"
                    app:boxCornerRadiusBottomStart="@dimen/dp_18"
                    app:boxCornerRadiusTopEnd="@dimen/dp_18"
                    app:boxCornerRadiusTopStart="@dimen/dp_18"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_gender">

                    <AutoCompleteTextView
                        android:id="@+id/et_gender"
                        style="@style/style_edit_text"
                        android:editable="false"
                        android:focusable="false"
                        android:fontFamily="@font/inter_reguler"
                        android:layout_marginTop="0dp"
                        android:layout_height="match_parent"
                        android:drawableStart="@drawable/ic_gender"
                        android:paddingBottom="@dimen/dp_15" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/img_drop_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_collapse"
                    app:layout_constraintBottom_toBottomOf="@+id/til_gender"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_gender" />

                <TextView
                    android:id="@+id/tv_gender_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Please select your gender"
                    android:visibility="gone"
                    android:textColor="@color/error_msg_text_color"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/til_gender" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_smoking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_smoker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Are you a smoker ?"
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/secondary_front_color"
                    android:fontFamily="@font/inter_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/smoker_radio_group"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_smoker">

                    <RadioButton
                        android:id="@+id/yes_smoker_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color"
                        android:checked="true"
                        android:fontFamily="@font/inter_reguler"
                        android:text="Yes" />

                    <RadioButton
                        android:id="@+id/no_smoker_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_reguler"
                        android:textColor="@color/text_color"
                        android:layout_marginStart="50dp"
                        android:text="No" />
                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/button_next"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:background="@drawable/bg_primary_button"
            android:layout_marginHorizontal="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_25"
            android:shadowColor="@color/primary_shadow_color"
            android:elevation="0.5dp"
            android:layout_marginBottom="@dimen/dp_18"
            android:textColor="@color/primary_button_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="@color/secondary_front_color"
                android:fontFamily="@font/inter_bold"
                android:text="Save"
                android:textSize="@dimen/sp_18"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_4"
            android:enabled="false"
            android:layout_marginBottom="@dimen/dp_4"
            android:fontFamily="@font/inter_thin"
            android:textStyle="bold"
            android:text=""
            android:gravity="center_horizontal"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/dim_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:alpha="0"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
