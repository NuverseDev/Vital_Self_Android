<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/theme_color</item>
        <item name="colorPrimaryVariant">@color/theme_color</item>
        <item name="colorOnPrimary">@color/white_both_theme</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/theme_color</item>
        <item name="colorSecondaryVariant">@color/theme_color</item>
        <item name="colorOnSecondary">@color/theme_color</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/theme_second_color</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Customize your theme here. -->
        <item name="android:actionMenuTextColor">@color/primary_text_color</item>
        <item name="android:textAllCaps">false</item>
        <!--Bottom navigation color-->
        <item name="android:navigationBarColor">@color/toolbar_bg_color</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="s">
            @android:color/transparent
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">
            @drawable/ic_transparent_bg
        </item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="TextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primary_text_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/sp_16</item>
    </style>

    <style name="TextViewStyleLight" parent="TextStyle">
        <item name="android:fontFamily">@font/manrope_light</item>
    </style>

    <style name="TextViewStyleRegular" parent="TextStyle">
        <item name="android:fontFamily">@font/manrope_regular</item>
    </style>

    <style name="TextViewStyleMedium" parent="TextStyle">
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>

    <style name="TextViewStyleSemiBold" parent="TextStyle">
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="TextViewStyleBold" parent="TextStyle">
        <item name="android:fontFamily">@font/manrope_bold</item>
    </style>


    <style name="EditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dp_45</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/edit_text_color</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/dp_20</item>
        <item name="paddingEnd">@dimen/dp_20</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">@dimen/sp_18</item>
    </style>


    <style name="ButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:paddingBottom">@dimen/dp_4</item>
        <item name="android:paddingTop">@dimen/dp_1</item>
        <item name="android:gravity">center</item>
        <!--        <item name="background">@drawable/button_disabled</item>-->
    </style>

    <style name="SpinnerTheme" parent="android:Widget.Material.Spinner.Underlined">
        <item name="android:background">@drawable/spinner_bg_dropdown
        </item>
        <item name="android:popupBackground">@drawable/spinner_bg_dropdown
        </item>

        <item name="android:textAlignment">textStart</item>
    </style>

    <style name="DateText" parent="TextAppearance.MaterialCalendarWidget.Date">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ButtonStyleEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:textColor">@color/black_both_theme</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">@dimen/sp_17</item>
        <!--        <item name="background">@drawable/button_disabled</item>-->
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/edit_border_color</item>
        <item name="boxStrokeWidth">@dimen/dp_1</item>
        <item name="boxStrokeWidthFocused">@dimen/dp_2</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="hintTextColor">@color/hint_highlight_color</item>
        <item name="android:textColor">@color/primary_text_color</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:background">@drawable/rc_edit_bg_10</item>
        <item name="android:textSize">@dimen/sp_16</item>
    </style>

    <style name="Rounded" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dp_5</item>
    </style>



    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/white_top_rounded_bg</item>
    </style>

    <style name="TabDefaultText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="textAllCaps">true</item>
        <item name="android:padding">@dimen/dp_10</item>
        <item name="fontFamily">@font/manrope_bold</item>
    </style>

    <style name="TabSelectedText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="textAllCaps">true</item>
        <item name="android:padding">@dimen/dp_10</item>
        <item name="fontFamily">@font/manrope_bold</item>
    </style>

    <style name="CustomHomeTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="textAllCaps">false</item>
        <item name="fontFamily">@font/manrope_semibold</item>
    </style>

    <dimen name="dp_12">12dp</dimen>
    <dimen name="dp_42">42dp</dimen>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />



    <style name="WeekDayText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <!--<item name="android:windowCloseOnTouchOutside">false</item>-->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

</resources>