<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="270"
    android:toDegrees="270">

    <shape
        android:shape="ring"
        android:thickness="8dp"
        android:innerRadiusRatio="3"
        android:useLevel="false">

        <size
            android:width="100dp"
            android:height="100dp" />

        <gradient
            android:type="sweep"
            android:useLevel="false"
            android:angle="0"
            android:startColor="@color/good_dot_color"
            android:centerColor="@color/medium_dot_color"
            android:endColor="@color/low_score_color" />

    </shape>
</rotate>
