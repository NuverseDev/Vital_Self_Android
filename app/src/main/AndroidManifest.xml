<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="34">

        <activity
            android:name=".view.SplashScreen"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.auth.ActivityUserLogin"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|adjustPan"/>

        <activity
            android:name=".view.auth.ActivitySignUp"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|adjustPan"/>

        <activity
            android:name=".view.profile.ActivityProfile"
            android:exported="false"/>

        <activity
            android:name=".view.scan.VitalScanActivity"
            android:exported="false"/>
        <activity
            android:name=".view.packages.PackagesActivity"
            android:exported="false"/>
        <activity
            android:name=".view.scan.VitalResultActivity2"
            android:exported="false"/>
        <activity
            android:name=".view.scan.VitalResultActivity"
            android:exported="false"/>

        <activity
            android:name=".view.history.ScanHistory"
            android:exported="true"/>
        <activity
            android:name=".view.qr_code.CaptureActivityPortrait"
            android:exported="true"/>
        <activity
            android:name=".view.qr_code.QrScanActivity"
            android:exported="true"/>
        <activity
            android:name=".view.utils.ActivityHowToScan"
            android:exported="true"/>





        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.vital_self.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>